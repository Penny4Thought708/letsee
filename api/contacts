// GET /api/contacts
router.get("/contacts", authMiddleware, async (req, res) => {
  try {
    const userId = req.user.id;

    // Fetch contacts with profile info
    const { rows } = await db.query(
      `
      SELECT 
        u.id           AS contact_id,
        u.fullname     AS contact_name,
        u.email        AS contact_email,
        u.avatar       AS avatar_filename,
        u.phone        AS contact_phone,
        u.bio          AS contact_bio,
        u.banner       AS contact_banner,
        c.blocked      AS blocked,
        c.is_favorite  AS is_favorite,
        c.created_at   AS added_on
      FROM contacts c
      JOIN users u ON c.contact_id = u.id
      WHERE c.user_id = $1
      ORDER BY u.fullname ASC
      `,
      [userId]
    );

    const contacts = [];
    const blocked = [];

    // Last message + unread count query
    const msgQuery = `
      SELECT 
        pm.message,
        pm.created_at,
        (
          SELECT COUNT(*) 
          FROM private_messages 
          WHERE receiver_id = $1 
            AND sender_id = $2 
            AND seen = 0
        ) AS unread_count
      FROM private_messages pm
      WHERE 
        (pm.sender_id = $2 AND pm.receiver_id = $1)
        OR
        (pm.sender_id = $1 AND pm.receiver_id = $2)
      ORDER BY pm.created_at DESC
      LIMIT 1
    `;

    for (const row of rows) {
      const contactId = row.contact_id;

      const msg = await db.query(msgQuery, [userId, contactId]);
      const last = msg.rows[0] || {};

      const contact = {
        id: contactId,
        name: row.contact_name,
        email: row.contact_email,

        avatar: row.avatar_filename
          ? `https://letsee-backend.onrender.com/uploads/avatars/${row.avatar_filename}`
          : `https://letsee-backend.onrender.com/img/defaultUser.png`,

        phone: row.contact_phone,
        bio: row.contact_bio,

        banner: row.contact_banner
          ? `https://letsee-backend.onrender.com/uploads/banners/${row.contact_banner}`
          : `https://letsee-backend.onrender.com/img/profile-banner.jpg`,

        is_favorite: row.is_favorite,
        added_on: row.added_on,
        online: false,

        lastMessage: {
          text: last.message || "",
          timestamp: last.created_at || null,
        },

        unread: Number(last.unread_count || 0),
      };

      if (row.blocked) blocked.push(contact);
      else contacts.push(contact);
    }

    res.json({ contacts, blocked });

  } catch (err) {
    console.error("contacts error:", err);
    res.status(500).json({ contacts: [], blocked: [], error: err.message });
  }
});


