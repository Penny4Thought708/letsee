// DELETE /api/profile/banner
router.delete("/profile/banner", authMiddleware, async (req, res) => {
  try {
    const userId = req.user.id;

    await db.query(`
      UPDATE users
      SET banner = NULL
      WHERE user_id = $1
    `, [userId]);

    res.json({ success: true });

  } catch (err) {
    res.json({ success: false, error: err.message });
  }
});
