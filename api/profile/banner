// POST /api/profile/banner
router.post("/profile/banner", authMiddleware, upload.single("banner"), async (req, res) => {
  try {
    const userId = req.user.id;

    await db.query(`
      UPDATE users
      SET banner = $1
      WHERE user_id = $2
    `, [req.file.filename, userId]);

    res.json({ success: true, banner: req.file.filename });

  } catch (err) {
    res.json({ success: false, error: err.message });
  }
});
