// DELETE /api/profile/avatar
router.delete("/profile/avatar", authMiddleware, async (req, res) => {
  try {
    const userId = req.user.id;

    // Remove avatar filename from DB
    await db.query(`
      UPDATE users
      SET avatar = NULL
      WHERE user_id = $1
    `, [userId]);

    res.json({ success: true });

  } catch (err) {
    res.json({ success: false, error: err.message });
  }
});
