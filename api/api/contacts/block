// POST /api/contacts/block
router.post("/contacts/block", authMiddleware, async (req, res) => {
  try {
    const userId = req.user.id;
    const { contact_id, blocked } = req.body;

    await db.query(`
      UPDATE contacts
      SET blocked = $1
      WHERE user_id = $2 AND contact_id = $3
    `, [blocked, userId, contact_id]);

    res.json({ success: true });

  } catch (err) {
    res.json({ success: false, error: err.message });
  }
});
