// GET /api/voicemail/list
router.get("/voicemail/list", authMiddleware, async (req, res) => {
  try {
    const userId = req.user.id;

    const { rows } = await db.query(`
      SELECT *
      FROM voicemails
      WHERE receiver_id = $1
      ORDER BY created_at DESC
    `, [userId]);

    res.json({ success: true, voicemails: rows });

  } catch (err) {
    res.json({ success: false, error: err.message });
  }
});
