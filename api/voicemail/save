// POST /api/voicemail/save
router.post("/voicemail/save", authMiddleware, upload.single("audio"), async (req, res) => {
  try {
    const userId = req.user.id;
    const { to_id } = req.body;

    const { rows } = await db.query(`
      INSERT INTO voicemails (sender_id, receiver_id, file)
      VALUES ($1, $2, $3)
      RETURNING *
    `, [userId, to_id, req.file.filename]);

    res.json({ success: true, voicemail: rows[0] });

  } catch (err) {
    res.json({ success: false, error: err.message });
  }
});
