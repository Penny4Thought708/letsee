// POST /api/messages/send
router.post("/messages/send", authMiddleware, async (req, res) => {
  try {
    const senderId = req.user.id;
    const { receiver_id, message, attachment } = req.body;

    if (!receiver_id || (!message && !attachment)) {
      return res.json({ success: false, error: "Missing fields" });
    }

    const { rows } = await db.query(`
      INSERT INTO messages (sender_id, receiver_id, message, attachment)
      VALUES ($1, $2, $3, $4)
      RETURNING *
    `, [senderId, receiver_id, message, attachment]);

    const msg = rows[0];

    // Emit via WebSocket
    io.to(`user_${receiver_id}`).emit("new_message", msg);

    res.json({ success: true, message: msg });

  } catch (err) {
    res.json({ success: false, error: err.message });
  }
});
